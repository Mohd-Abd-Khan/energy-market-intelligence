# ==============================================================================
# Energy Market Intelligence — Environment Configuration Template
# ==============================================================================
# Instructions:
#   1. Copy this file to `.env`:
#      cp .env.example .env   (Linux/macOS)
#      copy .env.example .env (Windows)
#   2. Fill in your valid API credentials and settings.
#   3. Note: `.env` is git-ignored and must NEVER be committed to version control.
# ==============================================================================

# --- EIA API Credentials ---
# Register for your free EIA (U.S. Energy Information Administration) API v2 key:
# https://www.eia.gov/opendata/
EIA_API_KEY=your_eia_api_key_here

# Base URL for EIA API v2 endpoint (Default: https://api.eia.gov/v2)
EIA_BASE_URL=https://api.eia.gov/v2

# --- Storage & Database Configuration ---
# Path to SQLite database file (relative to project root or absolute)
DB_PATH=data/commodity.db

# --- Analytics & Runtime Defaults ---
# Commodity selected on initial dashboard load.
# Available options: WTI_CRUDE, NATURAL_GAS, GASOLINE
DEFAULT_COMMODITY=WTI_CRUDE

# Default lookback window in days for historical ingestion (e.g. 730 = 2 years)
LOOKBACK_DAYS=730
